config {
  type: "incremental",
  schema: "silver",
  name: "clients_transformed_from_dataform2",
  description: "Tabla incremental de prueba2",
  bigquery: {
    partitionBy: "DATE(trasformed_at)"
  }
}

SELECT
  *,
  'dataform' AS user,
  CURRENT_DATETIME("${dataform.projectConfig.vars.time_zone}") AS trasformed_at
FROM
     ${ref("clients_external_from_dataform")}